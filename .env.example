# Copy to .env. Scout Copilot runs on Claude: briefs, reports, the assistant and the landing demo all need this key.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Optional: Claude responses are cached in .llm-cache so demos replay instantly. Set to "off" to disable.
# LLM_CACHE=off
# Optional: TheSportsDB key for real players' photos and clubs. The free shared key "123" is used when unset.
# THESPORTSDB_KEY=

# Supabase login: Project URL and publishable (anon) key from Project Settings > API. Never the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
